# Supabase Postgres (région UE) — voir docs/PLAN.md §9.1
# Connexion poolée (pgBouncer, mode transaction, port 6543) : utilisée par l'application.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Connexion directe (port 5432) : requise par Prisma pour les migrations.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Supabase Storage (bucket privé, PDF des devis)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY="" # ne quitte jamais le serveur — jamais NEXT_PUBLIC_

# Brevo (e-mails transactionnels)
BREVO_API_KEY=""
